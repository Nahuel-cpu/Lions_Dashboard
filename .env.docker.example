# Config del stack Docker (compose.yaml). Copiar a .env.docker y ajustar.
# No subir valores reales a git (control 11 de la guía 27 puntos).

APP_NAME="Lions Dashboard"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8088

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
# false mientras se acceda por http://localhost:8088; true con HTTPS real
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=sync
CACHE_STORE=database
BROADCAST_CONNECTION=reverb

LOG_CHANNEL=stack
LOG_LEVEL=info

# Reverb (websockets)
REVERB_APP_KEY=lionsreverbkey
REVERB_APP_SECRET=lionsreverbsecret
REVERB_APP_ID=lions
# servidor a servidor (app -> contenedor reverb)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Seed del demo en el primer arranque (base sin usuarios)
SEED_DEMO=true

# --- Shopify (opcional: sólo lectura, client credentials del Dev Dashboard) ---
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
